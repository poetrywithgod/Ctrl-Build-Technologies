---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CtrlBuild Technologies | Software Engineering & Digital Solutions',
  description = 'CtrlBuild Technologies builds custom software, web applications, mobile apps, business systems, AI solutions, analytics platforms and digital products for businesses in Nigeria and around the world.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />

    <meta name="theme-color" content="#4D001F" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
  </head>

  <body>
    <slot />

    <script is:inline>
      (() => {
        const storageKey = 'ctrlbuild-theme';
        const savedTheme = localStorage.getItem(storageKey);

        const prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches;

        document.documentElement.dataset.theme =
          savedTheme === 'dark' || savedTheme === 'light'
            ? savedTheme
            : prefersDark
              ? 'dark'
              : 'light';
      })();
    </script>
  </body>
</html>
