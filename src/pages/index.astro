---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <section class="cb-section">
      <div class="cb-container">
        <p class="cb-eyebrow">CtrlBuild Technologies</p>

        <h1 class="mt-5 max-w-5xl text-5xl font-semibold tracking-tight sm:text-6xl lg:text-8xl">
          We build the technology behind
          <span class="cb-gradient-text"> ambitious ideas.</span>
        </h1>

        <p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--color-text-muted)] sm:text-xl">
          Custom software, web applications, mobile products, business
          systems, AI, analytics and digital solutions built for businesses
          in Nigeria and around the world.
        </p>
      </div>
    </section>
  </main>
</Layout>
