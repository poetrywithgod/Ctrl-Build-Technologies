---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Work | CtrlBuild Technologies"
  description="The CtrlBuild Technologies portfolio is currently being prepared. Explore our services and solutions while we prepare selected project work."
>
  <main class="cb-work-page">
    <section class="cb-work-hero">
      <div class="cb-container">
        <p class="cb-eyebrow">/ WORK</p>

        <div class="cb-work-hero__content">
          <span class="cb-work-hero__status">COMING SOON</span>

          <h1>
            Our work is
            <span>taking shape.</span>
          </h1>

          <p>
            We are preparing a selection of projects, platforms and digital
            systems we've built for businesses and organisations. Check back
            soon to see what we've been working on.
          </p>

          <div class="cb-work-hero__actions">
            <a class="cb-work-hero__primary" href="/contact/">
              Start a project
              <span aria-hidden="true">↗</span>
            </a>

            <a class="cb-work-hero__secondary" href="/services/">
              Explore services
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="cb-work-hero__note">
          <span>STATUS</span>
          <strong>PORTFOLIO UNDER CONSTRUCTION</strong>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .cb-work-page {
    min-height: 70vh;
  }

  .cb-work-hero {
    display: flex;
    align-items: center;
    min-height: 78vh;
    padding: 9rem 0 7rem;
  }

  .cb-work-hero__content {
    max-width: 58rem;
    margin-top: 3rem;
  }

  .cb-work-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-brand-coral);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .cb-work-hero__status::before {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-brand-coral);
    content: '';
  }

  .cb-work-hero h1 {
    max-width: 9ch;
    margin-top: 1.25rem;
    font-size: clamp(3.5rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .cb-work-hero h1 span {
    color: var(--color-brand-coral);
  }

  .cb-work-hero__content > p {
    max-width: 39rem;
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .cb-work-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .cb-work-hero__primary,
  .cb-work-hero__secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .cb-work-hero__primary {
    padding: 0.9rem 1.2rem;
    background: var(--color-text);
    color: var(--color-bg);
  }

  .cb-work-hero__primary span,
  .cb-work-hero__secondary span {
    transition: transform 180ms ease;
  }

  .cb-work-hero__primary:hover span {
    transform: translate(3px, -3px);
  }

  .cb-work-hero__secondary {
    color: var(--color-brand-coral);
  }

  .cb-work-hero__secondary:hover span {
    transform: translateX(3px);
  }

  .cb-work-hero__note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 7rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
  }

  .cb-work-hero__note strong {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  @media (min-width: 700px) {
    .cb-work-hero {
      min-height: 82vh;
      padding: 11rem 0 8rem;
    }

    .cb-work-hero__content {
      margin-top: 4rem;
    }
  }

  @media (max-width: 600px) {
    .cb-work-hero {
      min-height: 75vh;
      padding: 7rem 0 5rem;
    }

    .cb-work-hero__content {
      margin-top: 2.5rem;
    }

    .cb-work-hero__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .cb-work-hero__note {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-work-hero__primary span,
    .cb-work-hero__secondary span {
      transition: none;
    }
  }
</style>
