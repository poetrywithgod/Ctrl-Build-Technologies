---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  label: string;
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  label,
  external = false,
} = Astro.props;

const classes = [
  'cb-button',
  `cb-button--${variant}`,
  `cb-button--${size}`,
].join(' ');
---

{href ? (
  <a
    class={classes}
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    <span>{label}</span>
    <span class="cb-button__arrow" aria-hidden="true">↗</span>
  </a>
) : (
  <button class={classes} type="button">
    <span>{label}</span>
    <span class="cb-button__arrow" aria-hidden="true">↗</span>
  </button>
)}

<style>
  .cb-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .cb-button:hover {
    transform: translateY(-2px);
  }

  .cb-button__arrow {
    font-size: 1rem;
    transition: transform 180ms ease;
  }

  .cb-button:hover .cb-button__arrow {
    transform: translate(2px, -2px);
  }

  .cb-button--primary {
    background: var(--color-brand-burgundy);
    color: #fff;
  }

  .cb-button--primary:hover {
    background: var(--color-brand-burgundy-deep);
  }

  .cb-button--secondary {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .cb-button--secondary:hover {
    border-color: var(--color-brand-coral);
  }

  .cb-button--ghost {
    color: var(--color-text);
  }

  .cb-button--ghost:hover {
    color: var(--color-brand-coral);
  }

  .cb-button--sm {
    min-height: 2.5rem;
    padding: 0 1rem;
    font-size: 0.875rem;
  }

  .cb-button--md {
    min-height: 3rem;
    padding: 0 1.25rem;
    font-size: 0.9375rem;
  }

  .cb-button--lg {
    min-height: 3.5rem;
    padding: 0 1.5rem;
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-button,
    .cb-button__arrow {
      transition: none;
    }

    .cb-button:hover {
      transform: none;
    }
  }
</style>
