<section class="cb-process" id="process">
  <div class="cb-container">
    <div class="cb-process__header">
      <div>
        <p class="cb-eyebrow">/ HOW WE BUILD</p>
        <h2>From <span>idea</span> to software that works.</h2>
      </div>

      <p class="cb-process__intro">
        Great software is not just about writing code. We understand the
        problem, design the right system, build it properly and stay focused
        on what happens after launch.
      </p>
    </div>

    <div class="cb-process__layout">
      <ol class="cb-process__steps" aria-label="Our development process">
        <li>
          <button
            type="button"
            class="cb-process__step is-active"
            data-process-step="0"
            aria-selected="true"
          >
            <span class="cb-process__step-number">01</span>
            <span class="cb-process__step-name">Discover</span>
            <span class="cb-process__step-arrow" aria-hidden="true">↗</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="cb-process__step"
            data-process-step="1"
            aria-selected="false"
          >
            <span class="cb-process__step-number">02</span>
            <span class="cb-process__step-name">Design</span>
            <span class="cb-process__step-arrow" aria-hidden="true">↗</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="cb-process__step"
            data-process-step="2"
            aria-selected="false"
          >
            <span class="cb-process__step-number">03</span>
            <span class="cb-process__step-name">Build</span>
            <span class="cb-process__step-arrow" aria-hidden="true">↗</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="cb-process__step"
            data-process-step="3"
            aria-selected="false"
          >
            <span class="cb-process__step-number">04</span>
            <span class="cb-process__step-name">Test</span>
            <span class="cb-process__step-arrow" aria-hidden="true">↗</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="cb-process__step"
            data-process-step="4"
            aria-selected="false"
          >
            <span class="cb-process__step-number">05</span>
            <span class="cb-process__step-name">Deploy</span>
            <span class="cb-process__step-arrow" aria-hidden="true">↗</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="cb-process__step"
            data-process-step="5"
            aria-selected="false"
          >
            <span class="cb-process__step-number">06</span>
            <span class="cb-process__step-name">Scale</span>
            <span class="cb-process__step-arrow" aria-hidden="true">↗</span>
          </button>
        </li>
      </ol>

      <div class="cb-process__detail" data-process-detail>
        <div class="cb-process__detail-top">
          <span class="cb-process__detail-index" data-process-index>01</span>
          <span class="cb-process__detail-label">PHASE</span>
        </div>

        <div class="cb-process__detail-content">
          <p class="cb-process__detail-kicker" data-process-kicker>
            Understand the opportunity
          </p>

          <h3 data-process-title>Discover</h3>

          <p data-process-description>
            We start by understanding your business, users, goals and
            constraints. The result is a clear definition of what needs to be
            built and why.
          </p>

          <div class="cb-process__detail-tags" data-process-tags>
            <span>Requirements</span>
            <span>Research</span>
            <span>Strategy</span>
          </div>
        </div>

        <div class="cb-process__detail-footer">
          <span>CTRLBUILD / PROCESS</span>
          <span data-process-progress>01 / 06</span>
        </div>
      </div>
    </div>

    <div class="cb-process__statement">
      <span class="cb-process__statement-line"></span>
      <p>Built deliberately. <strong>Not just quickly.</strong></p>
    </div>
  </div>
</section>

<script>
  const processData = [
    {
      number: '01',
      title: 'Discover',
      kicker: 'Understand the opportunity',
      description:
        'We start by understanding your business, users, goals and constraints. The result is a clear definition of what needs to be built and why.',
      tags: ['Requirements', 'Research', 'Strategy'],
    },
    {
      number: '02',
      title: 'Design',
      kicker: 'Shape the right solution',
      description:
        'We translate requirements into user journeys, interfaces, system architecture and a practical technical plan before development begins.',
      tags: ['UX / UI', 'Architecture', 'Planning'],
    },
    {
      number: '03',
      title: 'Build',
      kicker: 'Engineer the product',
      description:
        'We turn the approved design into production-quality software using modern technologies, clean architecture and maintainable code.',
      tags: ['Development', 'Integration', 'Engineering'],
    },
    {
      number: '04',
      title: 'Test',
      kicker: 'Make it dependable',
      description:
        'We validate functionality, usability, performance, security and edge cases so the system is ready for real users and real workloads.',
      tags: ['QA', 'Security', 'Performance'],
    },
    {
      number: '05',
      title: 'Deploy',
      kicker: 'Put it into the real world',
      description:
        'We prepare the application for production, configure the required infrastructure and deploy it with the operational foundations it needs.',
      tags: ['Infrastructure', 'CI / CD', 'Launch'],
    },
    {
      number: '06',
      title: 'Scale',
      kicker: 'Keep improving',
      description:
        'Launch is not the end. We monitor, optimise and evolve the system as users, data, requirements and the business grow.',
      tags: ['Monitoring', 'Optimisation', 'Growth'],
    },
  ];

  const processRoot = document.querySelector('[data-process-detail]');
  const processSteps = document.querySelectorAll<HTMLButtonElement>(
    '[data-process-step]'
  );

  if (processRoot && processSteps.length) {
    const index = processRoot.querySelector('[data-process-index]');
    const kicker = processRoot.querySelector('[data-process-kicker]');
    const title = processRoot.querySelector('[data-process-title]');
    const description = processRoot.querySelector('[data-process-description]');
    const tags = processRoot.querySelector('[data-process-tags]');
    const progress = processRoot.querySelector('[data-process-progress]');

    const updateProcess = (stepIndex: number) => {
      const step = processData[stepIndex];

      if (!step || !index || !kicker || !title || !description || !tags || !progress) {
        return;
      }

      processSteps.forEach((button, buttonIndex) => {
        const active = buttonIndex === stepIndex;

        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });

      index.textContent = step.number;
      kicker.textContent = step.kicker;
      title.textContent = step.title;
      description.textContent = step.description;
      progress.textContent = `${step.number} / 06`;

      tags.innerHTML = step.tags
        .map((tag) => `<span>${tag}</span>`)
        .join('');
    };

    processSteps.forEach((button) => {
      button.addEventListener('click', () => {
        const stepIndex = Number(button.dataset.processStep);

        if (Number.isInteger(stepIndex)) {
          updateProcess(stepIndex);
        }
      });
    });
  }
</script>

<style>
