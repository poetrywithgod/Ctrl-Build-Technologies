    font-size: 0.7rem;
    font-weight: 600;
  }

  .cb-process__step-name {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .cb-process__step-arrow {
    color: var(--color-brand-coral);
    font-size: 1.1rem;
