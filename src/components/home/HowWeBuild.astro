    transform: translate(-0.4rem, 0.4rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .cb-process__step:hover .cb-process__step-arrow,
  .cb-process__step.is-active .cb-process__step-arrow {
