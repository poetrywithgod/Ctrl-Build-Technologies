---
import Button from '../ui/Button.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

const navigation = [
  { label: 'Services', href: '/services/' },
  { label: 'Solutions', href: '/solutions/' },
  { label: 'Work', href: '/work/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'About', href: '/about/' },
];
---

<header class="cb-navbar" data-navbar>
  <div class="cb-container cb-navbar__inner">
    <a class="cb-brand" href="/" aria-label="CtrlBuild Technologies home">
      <img
        class="cb-brand__logo"
        src="/ctrlbuild-logo.png"
        alt="CtrlBuild Technologies"
      />
    </a>

    <nav class="cb-navbar__desktop" aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="cb-navbar__actions">
      <ThemeToggle />

      <Button
        href="/contact/"
        label="Let's Talk"
        size="sm"
      />
    </div>

    <button
      class="cb-menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="cb-mobile-menu" id="mobile-navigation" data-mobile-menu>
    <nav aria-label="Mobile navigation">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>

      <div class="cb-mobile-menu__footer">
        <ThemeToggle />

        <Button
          href="/contact/"
          label="Let's Talk"
          size="md"
        />
      </div>
    </nav>
  </div>
</header>

<script>
  const navbar = document.querySelector<HTMLElement>('[data-navbar]');
  const menuToggle =
    document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileMenu =
    document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (navbar) {
    const updateNavbar = () => {
      navbar.classList.toggle('is-scrolled', window.scrollY > 12);
    };

    updateNavbar();
    window.addEventListener('scroll', updateNavbar, { passive: true });
  }

  if (menuToggle && mobileMenu) {
    const closeMenu = () => {
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Open navigation menu');
      mobileMenu.classList.remove('is-open');
      document.body.classList.remove('cb-menu-open');
    };

    menuToggle.addEventListener('click', () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        closeMenu();
      } else {
        menuToggle.setAttribute('aria-expanded', 'true');
        menuToggle.setAttribute('aria-label', 'Close navigation menu');
        mobileMenu.classList.add('is-open');
        document.body.classList.add('cb-menu-open');
      }
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        closeMenu();
      }
    });
  }
</script>

<style>
  .cb-navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: color-mix(
      in srgb,
      var(--color-bg) 82%,
      transparent
    );
    backdrop-filter: blur(18px);
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .cb-navbar.is-scrolled {
    border-color: var(--color-border);
    background: color-mix(
      in srgb,
      var(--color-bg) 92%,
      transparent
    );
  }

  .cb-navbar__inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .cb-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .cb-brand__logo {
    display: block;
    width: 9.5rem;
    height: auto;
    max-height: 3rem;
    object-fit: contain;
  }

  .cb-navbar__desktop {
    display: none;
  }

  .cb-navbar__desktop ul {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cb-navbar__desktop a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 180ms ease;
  }

  .cb-navbar__desktop a:hover {
    color: var(--color-text);
  }

  .cb-navbar__actions {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .cb-menu-toggle {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    cursor: pointer;
  }

  .cb-menu-toggle span {
    width: 1rem;
    height: 1px;
    background: var(--color-text);
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .cb-menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(0.2rem) rotate(45deg);
  }

  .cb-menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-0.2rem) rotate(-45deg);
  }

  .cb-mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 220ms ease;
  }

  .cb-mobile-menu > nav {
    min-height: 0;
  }

  .cb-mobile-menu.is-open {
    grid-template-rows: 1fr;
    border-top: 1px solid var(--color-border);
  }

  .cb-mobile-menu ul {
    margin: 0;
    padding: 1rem 1.5rem;
    list-style: none;
  }

  .cb-mobile-menu li + li {
    border-top: 1px solid var(--color-border);
  }

  .cb-mobile-menu li a {
    display: block;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
  }

  .cb-mobile-menu__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.5rem 1.5rem;
  }

  :global(body.cb-menu-open) {
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .cb-navbar__desktop {
      display: block;
    }

    .cb-navbar__actions {
      display: flex;
    }

    .cb-menu-toggle,
    .cb-mobile-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-navbar,
    .cb-mobile-menu,
    .cb-menu-toggle span {
      transition: none;
    }
  }
</style>
